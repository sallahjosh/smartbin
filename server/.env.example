# ─── Server configuration ───────────────────────────────────────────────
# Copy this file to `.env` and adjust the values to match your environment.

# HTTP port for the API server (and static React app in production)
PORT=3000

# JWT secret used to sign auth tokens. CHANGE THIS in production.
JWT_SECRET=smartbin_change_me_to_a_long_random_string

# Token lifetime (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# ─── Database (MySQL / MariaDB) ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartdustbin
DB_USER=root
DB_PASS=

# ─── Seed admin account (created on first run if the email is missing) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_PHONE=

# ─── Device health ──────────────────────────────────────────────────────
# Bins that haven't reported within this many minutes are flagged offline
# by the background watcher (also editable in Admin → Settings).
OFFLINE_AFTER_MINUTES=30

# ─── mNotify SMS gateway ────────────────────────────────────────────────
# SMS notifications activate automatically when an API key is present.
# Without a key, notifications are logged with status 'skipped' (never faked).
MNOTIFY_API_ENDPOINT=https://api.mnotify.com/api/sms/quick
MNOTIFY_API_KEY=
MNOTIFY_SENDER=SmartBin Cloud
