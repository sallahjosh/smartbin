# ===== SmartBin API server — environment template =====
# Copy to .env and fill in real values. NEVER commit the real .env.

# HTTP port the API listens on
PORT=3000

# --- Database (MySQL / MariaDB) ---
# Local dev (XAMPP MariaDB on this machine):
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=smartdustbin
DB_USER=root
DB_PASS=

# --- JWT ---
# Long random string used to sign login tokens.
JWT_SECRET=change-me-to-a-long-random-string

# --- SMS provider (optional; leave empty to log instead of send) ---
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
